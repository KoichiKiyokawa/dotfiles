[user]
  name = Koichi Kiyokawa
  email = koichi20110068@gmail.com

[init]
  defaultBranch = main

[core]
  editor = nvim
  ignorecase = false

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[pull]
  rebase = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[safe]
	directory = /Users/kiyokawa-koichi/workspace/pointclub/pointclub-web-frontend/.worktree/err-boundary
